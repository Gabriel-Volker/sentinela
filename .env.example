# ---------------------------------------------------------------
# Sentinela — variáveis de ambiente (valores fictícios de exemplo)
# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca versione o .env com credenciais reais.
# ---------------------------------------------------------------

# URL da instância watsonx Orchestrate (obtida em API details)
# NÃO termine com /v1 — o adaptador adiciona /v1/orchestrate/... automaticamente.
WXO_SERVICE_URL=https://your-instance.example.com

# Chave de API IBM Cloud com permissão na instância Orchestrate
WXO_API_KEY=your-iam-api-key-here

# IDs dos agentes criados na instância
WXO_AGENT_ANALISE_ID=agent-analise-uuid-here
WXO_AGENT_VALIDACAO_ID=agent-validacao-uuid-here

# IDs das ferramentas (preenchidos após importar_ferramentas.py)
WXO_TOOL_CONSULTAR_CONTEXTO_ID=tool-consultar-contexto-uuid
WXO_TOOL_REGISTRAR_ANALISE_ID=tool-registrar-analise-uuid
WXO_TOOL_EXECUTAR_DECISAO_ID=tool-executar-decisao-uuid

# Porta do servidor local (padrão: 8080)
SENTINELA_PORT=8080

# Host local (não expor na internet)
SENTINELA_HOST=127.0.0.1
